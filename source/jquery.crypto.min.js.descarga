
(function($){$.decrypt=function(string='',key=''){var string=CryptoJS.AES.decrypt(string,key);var string=string.toString(CryptoJS.enc.Utf8);return string;};$.encrypt=function(string='',key=''){var string=string.toString();var string=CryptoJS.AES.encrypt(string,key);var string=string.toString();return string;};})(jQuery,document);