function init_plugin($) {

	jQuery.fn.extend({

		validator: function (callback) {

			/************* Empieza funciones para los DOMAIN *************/
			jQuery(this).find('.domain').each(function () {

				var id = jQuery(this).attr('id');

				if (id === undefined) {
					var uid = Math.round(new Date().getTime() + (Math.random() * 100));
					id = 'input-email-' + uid;
					jQuery(this).attr('id', id);
				}

				var nil = jQuery(this).data('nil');

				if (nil === undefined) {
					nil = false;
				}

				if (nil) {

					var idN = id + '-Nil';

					jQuery(this).wrap('<div class="input-group" style="width: 100%;"></div>');
					jQuery(this).after('<div class="input-group-prepend"><div class="input-group-text"><input id="' + idN + '" class="nil" data-input="' + id + '" type="checkbox" checked></div></div>');

					if (jQuery(this).val() != '') {

						jQuery('#' + idN).prop('checked', false);

					}

				}

			});


			jQuery(document).on("keyup", ".domain", function () {

				var id = jQuery(this).attr('id');
				var nil = jQuery(this).data('nil');
				var value = jQuery(this).val();

				if (jQuery(this).next("span.error").length !== 0) {
					var error = jQuery(this).next("span.error");
					jQuery(error).remove();
				}

				if (nil !== undefined) {
					var idN = id + '-Nil';
					if (value === '') {
						jQuery('#' + idN).prop({
							checked: true
						});
					} else {
						jQuery('#' + idN).prop({
							checked: false
						});
					}
				}

				jQuery(this).removeClass('invalid');

			});
			/************* Termina funciones para los EMAIL *************/



			/************* Empieza funciones para los EMAIL *************/
			jQuery(this).find('.email').each(function () {

				var id = jQuery(this).attr('id');

				if (id === undefined) {
					var uid = Math.round(new Date().getTime() + (Math.random() * 100));
					id = 'input-email-' + uid;
					jQuery(this).attr('id', id);
				}

				var nil = jQuery(this).data('nil');

				if (nil === undefined) {
					nil = false;
				}

				if (nil) {

					var idN = id + '-Nil';

					jQuery(this).wrap('<div class="input-group" style="width: 100%;"></div>');
					jQuery(this).after('<div class="input-group-prepend"><div class="input-group-text"><input id="' + idN + '" class="nil" data-input="' + id + '" type="checkbox" checked></div></div>');

					if (jQuery(this).val() != '') {

						jQuery('#' + idN).prop('checked', false);

					}

				}

			});


			jQuery(document).on("keyup", ".email", function () {

				var id = jQuery(this).attr('id');
				var nil = jQuery(this).data('nil');
				var value = jQuery(this).val();

				if (jQuery(this).next("span.error").length !== 0) {
					var error = jQuery(this).next("span.error");
					jQuery(error).remove();
				}

				if (nil !== undefined) {
					var idN = id + '-Nil';
					if (value === '') {
						jQuery('#' + idN).prop({
							checked: true
						});
					} else {
						jQuery('#' + idN).prop({
							checked: false
						});
					}
				}

				jQuery(this).removeClass('invalid');

			});
			/************* Termina funciones para los EMAIL *************/



			/************* Empieza funciones para los EQUALTO *************/
			jQuery(document).on("keyup", ".equalto", function () {

				if (jQuery(this).next("span.error").length !== 0) {
					var error = jQuery(this).next("span.error");
					jQuery(error).remove();
				}

				jQuery(this).removeClass('invalid');

			});
			/************* Termina funciones para los EQUALTO *************/




			/************* Empieza funciones para los PHONE *************/
			jQuery(this).find('.phone').each(function () {

				var id = jQuery(this).attr('id');

				if (id === undefined) {
					var uid = Math.round(new Date().getTime() + (Math.random() * 100));
					id = 'input-phone-' + uid;
					jQuery(this).attr('id', id);
				}

				var nil = jQuery(this).data('nil');

				if (nil === undefined) {
					nil = false;
				}

				if (nil) {

					var idN = id + '-Nil';

					jQuery(this).wrap('<div class="input-group" style="width: 100%;"></div>');
					jQuery(this).after('<div class="input-group-prepend"><div class="input-group-text"><input id="' + idN + '" class="nil" data-input="' + id + '" type="checkbox" checked></div></div>');

					if (jQuery(this).val() != '') {

						jQuery('#' + idN).prop('checked', false);

					}

				}

			});


			jQuery(document).on("keyup", ".phone", function () {

				var id = jQuery(this).attr('id');
				var nil = jQuery(this).data('nil');
				var value = jQuery(this).val();

				if (jQuery(this).next("span.error").length !== 0) {
					var error = jQuery(this).next("span.error");
					jQuery(error).remove();
				}

				if (nil !== undefined) {

					var idN = id + '-Nil';

					if (value === '') {
						jQuery('#' + idN).prop('checked', true);
					} else {
						jQuery('#' + idN).prop('checked', false);
					}

				}

				jQuery(this).removeClass('invalid');

			});
			/************* Termina funciones para los PHONE *************/




			/************* Empieza funciones para los quantity *************/
			jQuery(this).find('.quantity').each(function () {

				var id = jQuery(this).attr('id');

				if (id === undefined) {

					var uid = Math.round(new Date().getTime() + (Math.random() * 100));
					id = 'input-required-' + uid;

					jQuery(this).attr('id', id);

				}

				var nil = jQuery(this).data('nil');

				if (nil === undefined) {
					nil = false;
				}

				if (nil) {

					var idN = id + '-Nil';

					jQuery(this).wrap('<div class="input-group" style="width: 100%;"></div>');
					jQuery(this).after('<div class="input-group-prepend"><div class="input-group-text"><input id="' + idN + '" class="nil" data-input="' + id + '" type="checkbox" checked></div></div>');

					if (jQuery(this).val() != '') {

						jQuery('#' + idN).prop('checked', false);

					}

				}

			});


			jQuery(document).on("keyup", ".quantity", function () {

				var id = jQuery(this).attr('id');
				var nil = jQuery(this).data('nil');
				var value = jQuery(this).val();

				if (jQuery(this).next("span.error").length !== 0) {
					var error = jQuery(this).next("span.error");
					jQuery(error).remove();
				}

				if (nil !== undefined) {
					var idN = id + '-Nil';
					if (value === '') {
						jQuery('#' + idN).prop({
							checked: true
						});
					} else {
						jQuery('#' + idN).prop({
							checked: false
						});
					}
				}

				jQuery(this).removeClass('invalid');

			});
			/************* Termina funciones para los quantity *************/


			/************* Empieza funciones para los REQUIRED *************/
			jQuery(this).find('.required').each(function () {

				var id = jQuery(this).attr('id');

				if (id === undefined) {

					var uid = Math.round(new Date().getTime() + (Math.random() * 100));
					id = 'input-required-' + uid;

					jQuery(this).attr('id', id);

				}

				var nil = jQuery(this).data('nil');

				if (nil === undefined) {
					nil = false;
				}

				if (nil) {

					var idN = id + '-Nil';

					jQuery(this).wrap('<div class="input-group" style="width: 100%;"></div>');
					jQuery(this).after('<div class="input-group-prepend"><div class="input-group-text"><input id="' + idN + '" class="nil" data-input="' + id + '" type="checkbox" checked></div></div>');

					if (jQuery(this).val() != '') {

						jQuery('#' + idN).prop('checked', false);

					}

				}

			});


			jQuery(document).on("keyup", ".required", function () {

				var id = jQuery(this).attr('id');
				var nil = jQuery(this).data('nil');
				var value = jQuery(this).val();

				if (jQuery(this).next("span.error").length !== 0) {
					var error = jQuery(this).next("span.error");
					jQuery(error).remove();
				}

				if (nil !== undefined) {
					var idN = id + '-Nil';
					if (value === '') {
						jQuery('#' + idN).prop({
							checked: true
						});
					} else {
						jQuery('#' + idN).prop({
							checked: false
						});
					}
				}

				jQuery(this).removeClass('invalid');

			});
			/************* Termina funciones para los REQUIRED *************/



			/************* Empieza funciones para los SELECT *************/
			jQuery(this).find('.select').each(function () {

				var id = jQuery(this).attr('id');

				if (id === undefined) {

					var uid = Math.round(new Date().getTime() + (Math.random() * 100));
					id = 'input-required-' + uid;

					jQuery(this).attr('id', id);

				}

				var nil = jQuery(this).data('nil');

				if (nil === undefined) {
					nil = false;
				}

				if (nil) {

					var idN = id + '-Nil';

					jQuery(this).wrap('<div class="input-group" style="width: 100%;"></div>');
					jQuery(this).after('<div class="input-group-prepend"><div class="input-group-text"><input id="' + idN + '" class="nil" data-input="' + id + '" type="checkbox" checked></div></div>');

				}

			});


			jQuery(document).on("change", ".select", function () {

				var id = jQuery(this).attr('id');
				var nil = jQuery(this).data('nil');



				if (jQuery(this).hasClass('select2-hidden-accessible')) {

					if (jQuery(this).next().next("span.error").length !== 0) {
						var error = jQuery(this).next().next("span.error");
						jQuery(error).remove();
					}

					jQuery(this).next('.select2-container').removeClass('invalid');

				} else if (jQuery(this).hasClass('selectized')) {

				} else {

					if (jQuery(this).next("span.error").length !== 0) {
						var error = jQuery(this).next("span.error");
						jQuery(error).remove();
					}

				}




				if (nil !== undefined) {

					var idN = id + '-Nil';

					var selected = jQuery(this).find('option:selected').val();
					var first = jQuery(this).find('option:first').val();

					if (first === selected) {
						jQuery('#' + idN).prop({
							checked: true
						});
					} else {
						jQuery('#' + idN).prop({
							checked: false
						});
					}

				}

				jQuery(this).removeClass('invalid');

			});
			/************* Termina funciones para los SELECT *************/



			/************* Empieza funciones para los URL *************/
			jQuery(this).find('.url').each(function () {

				var id = jQuery(this).attr('id');

				if (id === undefined) {
					var uid = Math.round(new Date().getTime() + (Math.random() * 100));
					id = 'input-url-' + uid;
					jQuery(this).attr('id', id);
				}

				var nil = jQuery(this).data('nil');

				if (nil === undefined) {
					nil = false;
				}

				if (nil) {

					var idN = id + '-Nil';

					jQuery(this).wrap('<div class="input-group" style="width: 100%;"></div>');
					jQuery(this).after('<div class="input-group-prepend"><div class="input-group-text"><input id="' + idN + '" class="nil" data-input="' + id + '" type="checkbox" checked></div></div>');

					if (jQuery(this).val() != '') {

						jQuery('#' + idN).prop('checked', false);

					}

				}

			});


			jQuery(document).on("keyup", ".url", function () {

				var id = jQuery(this).attr('id');
				var nil = jQuery(this).data('nil');
				var value = jQuery(this).val();

				if (jQuery(this).next("span.error").length !== 0) {
					var error = jQuery(this).next("span.error");
					jQuery(error).remove();
				}

				if (nil !== undefined) {
					var idN = id + '-Nil';
					if (value === '') {
						jQuery('#' + idN).prop({
							checked: true
						});
					} else {
						jQuery('#' + idN).prop({
							checked: false
						});
					}
				}

				jQuery(this).removeClass('invalid');

			});
			/************* Termina funciones para los URL *************/


			/************* Empieza funciones para los FILES *************/
			jQuery(this).find('.file').each(function () {

				var id = jQuery(this).attr('id');

				if (id === undefined) {
					var uid = Math.round(new Date().getTime() + (Math.random() * 100));
					id = 'input-file-' + uid;
					jQuery(this).attr('id', id);
				}


				var label = jQuery(this).attr('data-label');

				if (label === undefined) {
					label = 'Select...';
				}

				var wrap = id + '-W';

				jQuery(this).attr('data-wrap', wrap);
				jQuery(this).prop('type', 'file');
				jQuery(this).val('');

				jQuery(this).wrap('<span id="' + wrap + '" class="btn btn-danger btn-left btn-file">' + label + '</span>');


				var nil = jQuery(this).data('nil');

				if (nil === undefined) {
					nil = false;
				}

				if (nil) {
					setTimeout(function () {
						var idN = id + '-Nil';
						jQuery('#' + wrap).wrap('<div class="input-group" style="width: 100%;"></div>');
						jQuery('#' + wrap).after('<div class="input-group-prepend"><div class="input-group-text"><input id="' + idN + '" class="nil" data-input="' + id + '" type="checkbox" checked></div></div>');
					}, 20);
				}


			});




			jQuery(document).on("change", ".file", function () {

				var extensions = jQuery(this).attr('data-extensions');

				if (extensions == undefined) {

					extensions = '';

				} else {

					var filename = jQuery(this).val();
					var extension = filename.replace(/^.*\./, '');

					if (extension == filename) {
						extension = '';
					} else {
						extension = extension.toLowerCase();
					}

					var valido = 0;

					extensions = extensions.split(',');

					jQuery.each(extensions, function (key, value) {
						if (extension == value) {
							valido = parseInt(valido) + 1;
						}
					});


					if (valido == 0) {

						var mensajeEXT = jQuery(this).attr('data-extensions-message');

						if (mensajeEXT != undefined) {

							if (error && typeof error === 'function') {

								error(mensajeEXT);

							} else {

								alert(mensajeEXT);

							}

						}


						var nil = jQuery(this).data('nil');

						if (nil === undefined) {
							nil = false;
						}

						if (nil) {
							var id = jQuery(this).attr('id');
							var idN = id + '-Nil';
							jQuery('#' + idN).prop('checked', true);
						}


						var cancel = jQuery(this).attr('data-cancel');

						if (cancel === undefined) {
							cancel = false;
						}

						if (cancel) {

							var fn = window[cancel];

							if (typeof fn === "function") fn();

						}

						jQuery(this).parent().removeClass('btn-success').removeClass('btn-default').removeClass('btn-primary').removeClass('btn-info').removeClass('btn-warning').removeClass('btn-link');
						jQuery(this).parent().addClass('btn-danger');
						jQuery(this).val('');

					} else {

						var nil = jQuery(this).data('nil');

						if (nil === undefined) {
							nil = false;
						}

						if (nil) {
							var id = jQuery(this).attr('id');
							var idN = id + '-Nil';
							jQuery('#' + idN).prop('checked', false);
						}

						var success = jQuery(this).data('success');

						if (success === undefined) {
							success = false;
						}

						if (success) {

							var fn = window[success];

							if (typeof fn === "function") fn();

						}

						jQuery(this).parent().removeClass('btn-danger').removeClass('btn-default').removeClass('btn-primary').removeClass('btn-info').removeClass('btn-warning').removeClass('btn-link');
						jQuery(this).parent().addClass('btn-success');

					}


				}


			});
			/************* Termina funciones para los FILES *************/



			/************* Empieza funciones para los NIL *************/
			jQuery(document).on("click", ".nil", function () {

				var input = jQuery(this).data('input');

				if (jQuery(this).is(':checked')) {
					var estado = 'checked';
				} else {
					var estado = 'unchecked';
				}

				if (input !== undefined) {

					jQuery('#' + input).focus();

					if (estado == 'checked') {

						var tipo = jQuery('#' + input)[0].tagName;

						if (tipo == 'INPUT') {

							jQuery('#' + input).val('');

							if (jQuery('#' + input).hasClass("file")) {

								var cancel = jQuery('#' + input).attr('data-cancel');

								if (cancel === undefined) {
									cancel = false;
								}

								if (cancel) {

									var fn = window[cancel];

									if (typeof fn === "function") fn();

								}

								jQuery('#' + input).parent().removeClass('btn-success').removeClass('btn-default').removeClass('btn-primary').removeClass('btn-info').removeClass('btn-warning').removeClass('btn-link');
								jQuery('#' + input).parent().addClass('btn-danger');

							}

						} else if (tipo == 'TEXTAREA') {

							jQuery('#' + input).val('');

						} else if (tipo == 'SELECT') {

							jQuery('#' + input + ' option:first').attr('selected', true);

						}

						jQuery('#' + input).removeClass('invalid');

					}

				}

			});
			/************* Termina funciones para los NIL *************/




















			/*************************************** EMPIEZA EL ENVIO DEL FORMULARIO ***************************************/
			return jQuery(this).submit(function (event) {


				var errors = 0;

				/************* Empieza la validación para los DOMAIN *************/
				jQuery(this).find('.domain').each(function () {

					var id = jQuery(this).attr('id');
					var nil = jQuery(this).data('nil');
					var message = jQuery(this).data('message');

					if (jQuery(this).val() === '') {

						if (nil === undefined) {
							nil = false;
						}

						if (!nil) {

							if (message !== undefined) {

								if (jQuery(this).next("span.error").length === 0) {
									jQuery(this).after('<span class="error">' + message + '</span>');
								}

							}

							jQuery(this).addClass('invalid');

							event.preventDefault();
							errors = parseInt(errors) + 1;

						} else {

							var idN = id + '-Nil';
							jQuery('#' + idN).attr('checked', 'checked');

						}

					} else {

						var domain = jQuery(this).val();
						var re = new RegExp(/^((?:(?:(?:\w[\.\-\+]?)*)\w)+)((?:(?:(?:\w[\.\-\+]?){0,62})\w)+)\.(\w{2,8})$/);


						if (!domain.match(re)) {

							if (nil === undefined) {
								nil = false;
							}

							if (!nil) {

								if (message !== undefined) {

									if (jQuery(this).next("span.error").length === 0) {
										jQuery(this).after('<span class="error">' + message + '</span>');
									}

								}

								jQuery(this).addClass('invalid');

								event.preventDefault();
								errors = parseInt(errors) + 1;

							}

						}

					}

				});
				/************* Termina la validación para los EMAIL *************/




				/************* Empieza la validación para los EMAIL *************/
				jQuery(this).find('.email').each(function () {

					var id = jQuery(this).attr('id');
					var nil = jQuery(this).data('nil');
					var message = jQuery(this).data('message');

					if (jQuery(this).val() === '') {

						if (nil === undefined) {
							nil = false;
						}

						if (!nil) {

							if (message !== undefined) {

								if (jQuery(this).next("span.error").length === 0) {
									jQuery(this).after('<span class="error">' + message + '</span>');
								}

							}

							jQuery(this).addClass('invalid');

							event.preventDefault();
							errors = parseInt(errors) + 1;

						} else {

							var idN = id + '-Nil';
							jQuery('#' + idN).attr('checked', 'checked');

						}

					} else {

						var email = jQuery(this).val();
						var email = email.trim();

						if (!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,10})+$/.test(email)) {

							if (message !== undefined) {

								if (jQuery(this).next("span.error").length === 0) {
									jQuery(this).after('<span class="error">' + message + '</span>');
								}

							}

							jQuery(this).addClass('invalid');

							event.preventDefault();
							errors = parseInt(errors) + 1;

						}else{

							jQuery(this).val(email);

						}

					}

				});
				/************* Termina la validación para los EMAIL *************/





				/************* Empieza funciones para los EQUALTO *************/
				jQuery(this).find('.equalto').each(function () {

					var equalto = jQuery(this).attr("data-equalto");

					if (jQuery.trim(jQuery(this).val()) !== jQuery.trim(jQuery('#' + equalto).val())) {

						var message = jQuery(this).data('message');

						if (message !== undefined) {

							if (jQuery(this).next("span.error").length === 0) {
								jQuery(this).after('<span class="error">' + message + '</span>');
							}

						}

						jQuery(this).addClass('invalid');

						event.preventDefault();
						errors = parseInt(errors) + 1;

					}

				});
				/************* Termina funciones para los EQUALTO *************/







				/************* Empieza la validación para los PHONE *************/
				jQuery(this).find('.phone').each(function () {

					var id = jQuery(this).attr('id');

					var nil = jQuery(this).data('nil');
					var message = jQuery(this).data('message');

					if (jQuery(this).val() === '') {

						if (nil === undefined) {
							nil = false;
						}

						if (!nil) {

							if (message !== undefined) {

								if (jQuery(this).next("span.error").length === 0) {
									jQuery(this).after('<span class="error">' + message + '</span>');
								}

							}

							jQuery(this).addClass('invalid');

							event.preventDefault();
							errors = parseInt(errors) + 1;

						} else {

							var idN = id + '-Nil';
							jQuery('#' + idN).attr('checked', 'checked');

						}

					} else {

						var phone = jQuery(this).val();

						if (jQuery.isFunction(jQuery.fn.intlTelInput)) {

							var inputTel = window['intel' + id];

							var type = jQuery(this).data('type');

							if (type == 'any') {

								//var isValid = jQuery(this).intlTelInput("isValidNumber");

								var isValid = inputTel.isValidNumber();

							} else if (type == 'landline') {

								//var numberType = jQuery(this).intlTelInput("getNumberType");
								var numberType = inputTel.getNumberType();

								var isValid = false;

								if (numberType == intlTelInputUtils.numberType.FIXED_LINE) {

									var isValid = true;

								}

							} else if (type == 'mobile') {

								//var numberType = jQuery(this).intlTelInput("getNumberType");
								var numberType = inputTel.getNumberType();

								var isValid = false;

								if (numberType == intlTelInputUtils.numberType.MOBILE) {

									var isValid = true;

								}

							}

							if (!isValid) {

								if (message !== undefined) {

									if (jQuery(this).next("span.error").length === 0) {
										jQuery(this).after('<span class="error">' + message + '</span>');
									}

								}

								jQuery(this).addClass('invalid');

								event.preventDefault();

								errors = parseInt(errors) + 1;

							}


						} else {

							var found = phone.search(/^(\+{1}\d{2,3}\s?[(]{1}\d{1,3}[)]{1}\s?\d+|\+\d{2,3}\s{1}\d+|\d+){1}[\s|-]?\d+([\s|-]?\d+){1,2}$/);

							if (found < 0) {

								if (message !== undefined) {

									if (jQuery(this).next("span.error").length === 0) {
										jQuery(this).after('<span class="error">' + message + '</span>');
									}

								}

								jQuery(this).addClass('invalid');

								event.preventDefault();
								errors = parseInt(errors) + 1;

							}

						}


					}

				});
				/************* Termina la validación para los PHONE *************/




				/************* Empieza la validación para los QUANTITY *************/
				jQuery(this).find('.quantity').each(function () {

					var id = jQuery(this).attr('id');
					var nil = jQuery(this).data('nil');
					var message = jQuery(this).data('message');
					var words = parseInt(jQuery(this).data('words'));
					var wordserror = jQuery(this).data('words-error');

					if (jQuery(this).val() === '') {

						if (nil === undefined) {
							nil = false;
						}

						if (!nil) {

							if (message !== undefined) {

								if (jQuery(this).next("span.error").length === 0) {
									jQuery(this).after('<span class="error">' + message + '</span>');
								}

							}

							jQuery(this).addClass('invalid');

							event.preventDefault();
							errors = parseInt(errors) + 1;

						} else {

							if (jQuery(this).val() === '') {
								var idN = id + '-Nil';
								jQuery('#' + idN).attr('checked', 'checked');
							}

						}

					}else{

						var value = parseInt(jQuery(this).val());
						var minvalue = jQuery(this).data('value');

						if (minvalue !== undefined) {

							if(value <= minvalue){

								jQuery(this).addClass('invalid');

								event.preventDefault();
								errors = parseInt(errors) + 1;

							}

						}

					}

				});
				/************* Termina la validación para los QUANTITY *************/



				/************* Empieza la validación para los RADIO *************/
				var _radios = new Array();

				jQuery(this).find('.radio').each(function () {

					var _error = jQuery(this).data('error');

					if (_error === undefined) {

						var _error = 'Select an option for the radios inputs';

					}

					var _name = jQuery(this).attr('name');

					if (_radios[_name] === undefined) {

						_radios[_name] = _error;

					}

				});

				if (Object.keys(_radios).length > 0) {

					for (let _radio of Object.keys(_radios)) {

						var _value = jQuery('input[name='+_radio+']:checked', this).val();

						if(_value === undefined){

							error(_radios[_radio]);

							event.preventDefault();
							errors = parseInt(errors) + 1;

						}

					}

				}
				/************* Termina funciones para los RADIO *************/


				/************* Empieza la validación para los REQUIRED *************/
				jQuery(this).find('.required').each(function () {

					var id = jQuery(this).attr('id');
					var nil = jQuery(this).data('nil');
					var message = jQuery(this).data('message');
					var words = parseInt(jQuery(this).data('words'));
					var wordserror = jQuery(this).data('words-error');
					var value = jQuery(this).data('value');

					if (jQuery(this).val() === '') {

						if (nil === undefined) {
							nil = false;
						}

						if (!nil) {

							if (message !== undefined) {

								if (jQuery(this).next("span.error").length === 0) {
									jQuery(this).after('<span class="error">' + message + '</span>');
								}

							}

							jQuery(this).addClass('invalid');

							event.preventDefault();
							errors = parseInt(errors) + 1;

						} else {

							if (jQuery(this).val() === '') {
								var idN = id + '-Nil';
								jQuery('#' + idN).attr('checked', 'checked');
							}

						}

					}else{


						if(words > 0){

							var _words = jQuery(this).val();
							var _words = _words.trim();
							var _words = _words.split(' ').length;

							if(_words < words){

								if(wordserror != undefined){

									if (error && typeof error === 'function') {
										error(wordserror);
									} else {
										alert(wordserror);
									}

								}

								jQuery(this).addClass('invalid');

								event.preventDefault();
								errors = parseInt(errors) + 1;

							}

						}


						if (value !== undefined) {

							if(value == jQuery(this).val()){

								jQuery(this).addClass('invalid');

								event.preventDefault();
								errors = parseInt(errors) + 1;

							}

						}


					}

				});
				/************* Termina la validación para los REQUIRED *************/



				/************* Empieza la funcion para los SELECT *************/
				jQuery(this).find('.select').each(function () {

					if (jQuery(this).is('select')) {

						var value = jQuery(this).data('value');

						var message = jQuery(this).data('message');

						if (jQuery("option:selected", this).val() == value) {

							jQuery(this).addClass('invalid');

							if (message !== undefined) {

								if (jQuery(this).hasClass('select2-hidden-accessible')) {

									if (jQuery(this).next().next("span.error").length === 0) {
										jQuery(this).next().after('<span class="error">' + message + '</span>');
									}

								} else if (jQuery(this).hasClass('selectized')) {

								} else {

									if (jQuery(this).next("span.error").length === 0) {
										jQuery(this).after('<span class="error">' + message + '</span>');
									}

								}
							}

							if (jQuery(this).hasClass('selectized')) {
								jQuery(this).next().find('.selectize-input').addClass('invalid');
							}

							if (jQuery(this).hasClass('select2-hidden-accessible')) {

								jQuery(this).next('.select2-container').addClass('invalid');

							}

							event.preventDefault();
							errors = parseInt(errors) + 1;


						} else {

							jQuery(this).removeClass('invalid');

						}

					}

				});
				/************* Termina la funcion para los SELECT *************/



				/************* Empieza la funcion para las URL *************/
				jQuery(this).find('.url').each(function () {

					var id = jQuery(this).attr('id');
					var nil = jQuery(this).data('nil');
					var message = jQuery(this).data('message');

					//var urlregex = new RegExp("^(http:\/\/www.|https:\/\/www.|ftp:\/\/www.|www.){1}([0-9A-Za-z]+\.)");
					//var urlregex = new RegExp("(http|ftp|https)://[\w-]+(\.[\w-]+)+([\w.,@?^=%&amp;:/~+#-]*[\w@?^=%&amp;/~+#-])?");
					var urlregex = /(^|\s)((https?:\/\/)?[\w-]+(\.[\w-]+)+\.?(:\d+)?(\/\S*)?)/gi;

					if (urlregex.test(jQuery(this).val())) {

					} else {

						if (jQuery(this).val() !== "") {

							jQuery(this).addClass('invalid');

							if (message !== undefined) {

								if (jQuery(this).next("span.error").length === 0) {
									jQuery(this).after('<span class="error">' + message + '</span>');
								}

							}

							event.preventDefault();
							errors = parseInt(errors) + 1;

						} else {

							if (nil === undefined) {
								nil = false;
							}

							if (!nil) {

								jQuery(this).addClass('invalid');

								if (message !== undefined) {

									if (jQuery(this).next("span.error").length === 0) {
										jQuery(this).after('<span class="error">' + message + '</span>');
									}

								}

								event.preventDefault();
								errors = parseInt(errors) + 1;

							}

						}

					}

				});
				/************* Termina la funcion para las URL *************/









				/************* Empieza la funcion para FILE *************/
				jQuery(this).find('.file').each(function () {

					var nil = jQuery(this).attr('data-nil');

					if (nil == undefined) {
						nil = false;
					}

					if (jQuery(this).val() == '') {

						if (!nil) {

							var mensaje = jQuery(this).attr('data-message');

							if (mensaje != undefined) {

								if (error && typeof error === 'function') {
									error(mensaje);
								} else {
									alert(mensaje);
								}

							}

							evt.preventDefault();
							errores = parseInt(errores) + 1

						}

					}

				});
				/************* Termina la funcion para FILE *************/






				/************* Empieza la validación para los HIDE *************/
				jQuery(this).find('.hide').each(function () {

					if (jQuery(this).is("input")) {

						var message = jQuery(this).data('message');

						if (jQuery(this).val() === '') {

							if (message === undefined) {
								message = 'A hidden field can not be empty';
							}

							if (error && typeof error === 'function') {
								error(message);
							} else {
								alert(message);
							}

							event.preventDefault();

							errors = parseInt(errors) + 1;

						}

					}

				});
				/************* Termina la validación para los HIDE *************/










				jQuery(this).find('.jQValSwitch').each(function () {

					if (jQuery(this).is(':checked')) {

						var mensaje = jQuery(this).attr('mensaje');

						if (mensaje != undefined) {

							if (error && typeof error === 'function') {
								error(mensaje);
							} else {
								alert(mensaje);
							}

						}

						evt.preventDefault();
						errores = parseInt(errores) + 1
					}

				});


				jQuery(this).find('.invalid').first().focus();


				/***** Empieza callback *****/
				if (errors == 0) {

					event.preventDefault();
					callback.call(this);

				}
				/***** Termina callback *****/

			});

			/************* Termina envio del formulario*************/


		}
	});

	//Init
}
init_plugin(jQuery);