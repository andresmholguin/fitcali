function alert(title, content, autoclose = true) {

	if (typeof content == 'undefined' || content == '') {
		content = title;
		title = false;
	}

	if (autoclose) {

		var obj = jQuery.alert({
			title: title,
			content: content,
			draggable: false,
			escapeKey: true,
			theme: 'modern'
		});

		setTimeout(function () {
			obj.close();
		}, 4000);

	} else {
		jQuery.alert({
			title: title,
			content: content,
			draggable: false,
			escapeKey: true,
			theme: 'modern'
		});
	}
}



function error(title, content, autoclose = true) {

	if (typeof content == 'undefined' || content == '') {
		content = title;
		title = false;
	}

	if (autoclose) {

		var obj = jQuery.alert({
			icon: 'icon-warning3',
			title: title,
			content: content,
			draggable: false,
			escapeKey: true,
			theme: 'modern',
			type: 'red'
		});

		setTimeout(function () {
			obj.close();
		}, 4000);

	} else {
		jQuery.alert({
			icon: 'icon-warning3',
			title: title,
			content: content,
			draggable: false,
			escapeKey: true,
			theme: 'modern',
			type: 'red'
		});
	}

}




