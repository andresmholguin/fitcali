
function init_plugin($){jQuery.fn.extend({csrf:function(options){var settings=jQuery.extend({inputs:"",action:"",form:jQuery(this).attr('id')},options);if(settings.action===''){if(settings.inputs!==''&&settings.form!==''){var variable='csrf'+settings.form;window[variable]={};var data=settings.inputs;jQuery.each(jQuery.parseJSON(data),function(index,value){window[variable][index]=value;});}}else if(settings.action==='get'){var variable='csrf'+settings.form;var r=window[variable];return r;}else if(settings.action==='regenerate'){if(settings.inputs!==''&&settings.form!==''){var data=settings.inputs;var form=settings.form;var variable='csrf'+settings.form;window[variable]={};jQuery.each(data,function(i,item){var o=data[i].o;var n=data[i].n;var name=data[i].name;window[variable][name]=n;jQuery('#'+o).each(function(){if(jQuery(this).hasClass('email')){var nil=jQuery(this).data('nil');if(nil===undefined){nil=false;}
if(nil){var nilO=o+'-Nil';var nilN=n+'-Nil';jQuery('#'+nilO).each(function(){jQuery(this).attr('id',nilN);jQuery(this).attr('data-input',n);});}
jQuery('#'+o).each(function(){jQuery(this).attr('id',n);jQuery(this).attr('name',n);jQuery(this).attr('data-o',o);});setTimeout(function(){jQuery('#'+n).removeAttr('data-o');},1000);}else if(jQuery(this).hasClass('equalto')){var refered=jQuery(this).attr("data-equalto");refered=jQuery("#"+form).find("[data-o='"+refered+"']");refered=jQuery(refered).attr('id');jQuery('#'+o).each(function(){jQuery(this).attr('id',n);jQuery(this).attr('name',n);jQuery(this).attr('data-equalto',refered);});}else if(jQuery(this).hasClass('required')){var nil=jQuery(this).data('nil');if(nil===undefined){nil=false;}
if(nil){var nilO=o+'-Nil';var nilN=n+'-Nil';jQuery('#'+nilO).each(function(){jQuery(this).attr('id',nilN);jQuery(this).attr('data-input',n);});}
jQuery('#'+o).each(function(){jQuery(this).attr('id',n);jQuery(this).attr('name',n);jQuery(this).attr('data-o',o);});setTimeout(function(){jQuery('#'+n).removeAttr('data-o');},1000);}else{jQuery('#'+o).each(function(){jQuery(this).attr('id',n);jQuery(this).attr('name',n);});}
var label=jQuery("#"+form).find("[for='"+o+"']");jQuery(label).attr('for',n);});});}}}});}
init_plugin(jQuery);